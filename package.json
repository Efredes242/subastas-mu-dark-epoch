{
  "name": "subastas-kundun",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/iconos.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply subastas-kundun --local",
    "db:migrate:remote": "wrangler d1 migrations apply subastas-kundun --remote",
    "db:seed": "node scripts/seed-admin.mjs --local",
    "db:seed:remote": "node scripts/seed-admin.mjs --remote",
    "db:reset": "rimraf .wrangler/state/v3/d1 && npm run db:migrate && npm run db:seed",
    "cf-typegen": "wrangler types",
    "iconos": "node scripts/iconos.mjs"
  },
  "dependencies": {
    "hono": "^4.9.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.14.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "rimraf": "^6.0.1",
    "sharp": "^0.35.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260831.1": true
  }
}
